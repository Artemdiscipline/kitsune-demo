{
  "name": "kitsune-showcase",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {"node": ">=22.13.0"},
  "scripts": {
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "dev": "node --env-file-if-exists=.env server/index.mjs",
    "bot": "node --env-file-if-exists=.env server/bot.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "node --check dist/app.js && node --check dist/shared/model.js && node --check server/index.mjs && node --check server/bot.mjs"
  }
}
