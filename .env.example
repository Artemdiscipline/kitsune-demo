# demo: browser-only requests. telegram: authenticated server API + SQLite.
APP_MODE=demo
PORT=4173
HOST=127.0.0.1
# Set to https://your-own-domain.example (no trailing slash) for Telegram.
MINI_APP_URL=https://your-own-domain.example
BOT_TOKEN=
# Numeric Telegram user IDs, comma-separated. No usernames.
ADMIN_TELEGRAM_IDS=
# Only the project owner's separate test chat. Never the studio's contact.
TEST_ADMIN_CHAT_ID=
DATABASE_PATH=./data/kitsune.sqlite
INIT_DATA_TTL_SECONDS=3600
